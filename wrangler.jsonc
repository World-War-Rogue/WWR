{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wwr",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-03",

  // The built client is served straight from the edge. run_worker_first sends
  // only /api/* through the Worker, so game requests hit real logic while
  // every other path is a static file. Without it, single-page-application
  // not_found_handling would answer /api/* with index.html and the API would
  // silently never run.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wwr-db",
      "database_id": "b4742b18-4dd7-408e-b692-c54d5919a0b2"
    }
  ],

  // Workers AI, used only to translate chat. Failures are swallowed and the
  // message simply shows untranslated, so a model outage degrades chat rather
  // than breaking it.
  "ai": {
    "binding": "AI"
  },

  "vars": {
    // Internal error text is no longer returned to the browser. The real
    // exception is still logged and readable with `wrangler tail`; set this
    // to "on" temporarily when a failure needs diagnosing from the response.
    "DEBUG_ERRORS": "off"
  },

  "observability": {
    "enabled": true
  },

  // The test realm: a second Worker with its own database, so bot raids and
  // reset drills never touch the server real testers are on. Deploy with
  // `npx wrangler deploy --env test`; migrate with
  // `npx wrangler d1 migrations apply wwr-test-db --remote --env test`.
  // Bindings do not inherit between environments, so every one is repeated.
  // Do NOT let `wrangler d1 create` add a binding at the top level: that
  // attaches the test database to the live Worker.
  "env": {
    "test": {
      "name": "wwr-test",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wwr-test-db",
          "database_id": "d8760390-d447-4077-a68f-c9409d1e8416"
        }
      ],
      "ai": {"binding": "AI"},
      "vars": {
        "DEBUG_ERRORS": "on",
        "TEST_BOTS_MAY_ATTACK": "on",
        // The qa-progression-max seed tools (worker/devProgression.ts).
        // Test realm only. Never add this to the top-level vars.
        "ALLOW_DEV_PROGRESSION_SEEDS": "true"
      }
    }
  }
}
